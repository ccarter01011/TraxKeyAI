    {
      "id": "ac-insert",
      "name": "Insert Calendar",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        300
      ],
      "notes": "WHERE EXISTS ties the unit to the caller's own company via its property, same tenant-isolation pattern as every other insert here.",
      "parameters": {
        "query": "INSERT INTO traxkey.unit_calendars (unit_id, source, ical_url)\nSELECT\n  '{{ $(\"Add Calendar (Webhook)\").first().json.body.unitId }}',\n  '{{ $(\"Add Calendar (Webhook)\").first().json.body.source || \"other\" }}',\n  '{{ $(\"Add Calendar (Webhook)\").first().json.body.icalUrl.replace(/'/g, \"''\") }}'\nWHERE EXISTS (\n  SELECT 1 FROM traxkey.units u\n  JOIN traxkey.properties p ON p.id = u.property_id\n  WHERE u.id = '{{ $(\"Add Calendar (Webhook)\").first().json.body.unitId }}'\n  AND p.company_id = '{{ $json.company_id }}'\n)\nRETURNING id;",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
