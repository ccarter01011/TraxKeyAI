    {
      "id": "go-get",
      "name": "Get Occupancy",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        850
      ],
      "notes": "is_blocked excluded: an owner-blocked unit is unavailable but empty, only a real reservation means someone is actually there.",
      "parameters": {
        "query": "SELECT b.unit_id, b.checkin_date, b.checkout_date, b.guest_label,\n  u.unit_number, p.name AS property_name\nFROM traxkey.bookings b\nJOIN traxkey.units u ON u.id = b.unit_id\nJOIN traxkey.properties p ON p.id = u.property_id\nWHERE p.company_id = '{{ $json.company_id }}'\nAND NOT b.is_blocked\nAND b.checkout_date >= CURRENT_DATE\nORDER BY b.checkin_date\nLIMIT 100;",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
