    {
      "id": "gc-get",
      "name": "Get Calendars",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        32
      ],
      "parameters": {
        "query": "SELECT uc.id, uc.unit_id, uc.source, uc.ical_url, uc.last_synced_at, uc.last_sync_error,\n  u.unit_number, p.name AS property_name,\n  (SELECT count(*) FROM traxkey.bookings b WHERE b.calendar_id = uc.id AND b.checkout_date >= CURRENT_DATE) AS upcoming_bookings\nFROM traxkey.unit_calendars uc\nJOIN traxkey.units u ON u.id = uc.unit_id\nJOIN traxkey.properties p ON p.id = u.property_id\nWHERE p.company_id = '{{ $json.company_id }}'\nORDER BY p.name, u.unit_number;",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
