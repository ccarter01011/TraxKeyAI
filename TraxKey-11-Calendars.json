    {
      "id": "dc-delete",
      "name": "Delete Calendar",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        580
      ],
      "notes": "Bookings cascade-delete with the calendar row. Scoped to the caller's own company so one company can't remove another's calendar.",
      "parameters": {
        "query": "DELETE FROM traxkey.unit_calendars uc\nUSING traxkey.units u, traxkey.properties p\nWHERE uc.id = '{{ $(\"Delete Calendar (Webhook)\").first().json.body.calendarId }}'\nAND u.id = uc.unit_id AND p.id = u.property_id\nAND p.company_id = '{{ $json.company_id }}'\nRETURNING uc.id;",
        "options": {},
        "operation": "executeQuery"
