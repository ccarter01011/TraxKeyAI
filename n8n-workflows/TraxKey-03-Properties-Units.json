    {
      "id": "crp-insert",
      "name": "Insert Property",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        544
      ],
      "parameters": {
        "query": "INSERT INTO traxkey.properties (company_id, name, address_line1, address_line2, city, state, zip, property_type)\nVALUES (\n  '{{ $json.company_id }}',\n  '{{ $(\"Create Property (Webhook)\").first().json.body.name.replace(/'/g, \"''\") }}',\n  '{{ $(\"Create Property (Webhook)\").first().json.body.addressLine1.replace(/'/g, \"''\") }}',\n  {{ $(\"Create Property (Webhook)\").first().json.body.addressLine2 ? \"'\" + $(\"Create Property (Webhook)\").first().json.body.addressLine2.replace(/'/g, \"''\") + \"'\" : 'NULL' }},\n  '{{ $(\"Create Property (Webhook)\").first().json.body.city.replace(/'/g, \"''\") }}',\n  '{{ $(\"Create Property (Webhook)\").first().json.body.state.replace(/'/g, \"''\") }}',\n  '{{ $(\"Create Property (Webhook)\").first().json.body.zip.replace(/'/g, \"''\") }}',\n  '{{ $(\"Create Property (Webhook)\").first().json.body.propertyType.replace(/'/g, \"''\") }}'\n)\nRETURNING id;",
        "options": {},
        "operation": "executeQuery"
