    {
      "id": "cru-insert",
      "name": "Insert Unit",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        800
      ],
      "notes": "The WHERE EXISTS clause is the tenant-isolation check: the property must belong to the caller's own company, or nothing gets inserted and this returns zero rows. Same pattern as TraxSail's inline session-scoped updates.",
      "parameters": {
        "query": "INSERT INTO traxkey.units (property_id, unit_number, bedrooms, bathrooms, status)\nSELECT\n  '{{ $(\"Create Unit (Webhook)\").first().json.body.propertyId }}',\n  {{ $(\"Create Unit (Webhook)\").first().json.body.unitNumber ? \"'\" + $(\"Create Unit (Webhook)\").first().json.body.unitNumber.replace(/'/g, \"''\") + \"'\" : 'NULL' }},\n  {{ $(\"Create Unit (Webhook)\").first().json.body.bedrooms || 'NULL' }},\n  {{ $(\"Create Unit (Webhook)\").first().json.body.bathrooms || 'NULL' }},\n  'occupied'\nWHERE EXISTS (\n  SELECT 1 FROM traxkey.properties\n  WHERE id = '{{ $(\"Create Unit (Webhook)\").first().json.body.propertyId }}'\n  AND company_id = '{{ $json.company_id }}'\n)\nRETURNING id;",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "typeVersion": 2.5,
      "alwaysOutputData": true
    },
