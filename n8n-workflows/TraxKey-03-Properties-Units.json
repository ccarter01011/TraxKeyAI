    {
      "id": "cru-insert",
      "name": "Insert Unit",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        800
      ],
      "notes": "The WHERE EXISTS clause is the tenant-isolation check: the property must belong to the caller's own company, or nothing gets inserted and this returns zero rows. Same pattern as TraxSail's inline session-scoped updates.",
      "parameters": {
        "query": "WITH guard AS (\n  SELECT\n    EXISTS (\n      SELECT 1 FROM traxkey.properties\n      WHERE id = '{{ (String($(\"Create Unit (Webhook)\").first().json.body.propertyId || \"\")).replace(/[^a-zA-Z0-9._:-]/g, \"\") }}'\n        AND company_id = '{{ $json.company_id }}'\n    ) AS owns_property,\n    traxkey.company_can_add_unit('{{ $json.company_id }}') AS under_limit,\n    traxkey.plan_unit_limit((SELECT plan FROM traxkey.companies WHERE id = '{{ $json.company_id }}')) AS unit_limit\n),\nins AS (\n  INSERT INTO traxkey.units (property_id, unit_number, bedrooms, bathrooms)\n  SELECT\n    '{{ (String($(\"Create Unit (Webhook)\").first().json.body.propertyId || \"\")).replace(/[^a-zA-Z0-9._:-]/g, \"\") }}',\n    {{ $(\"Create Unit (Webhook)\").first().json.body.unitNumber ? \"'\" + $(\"Create Unit (Webhook)\").first().json.body.unitNumber.replace(/'/g, \"''\") + \"'\" : 'NULL' }},\n    {{ [null,undefined,''].includes($(\"Create Unit (Webhook)\").first().json.body.bedrooms) || !Number.isFinite(Number($(\"Create Unit (Webhook)\").first().json.body.bedrooms)) ? 'NULL' : Number($(\"Create Unit (Webhook)\").first().json.body.bedrooms) }},\n    {{ [null,undefined,''].includes($(\"Create Unit (Webhook)\").first().json.body.bathrooms) || !Number.isFinite(Number($(\"Create Unit (Webhook)\").first().json.body.bathrooms)) ? 'NULL' : Number($(\"Create Unit (Webhook)\").first().json.body.bathrooms) }}\n  FROM guard\n  WHERE guard.owns_property AND guard.under_limit\n  RETURNING id\n)\nSELECT\n  COALESCE((SELECT id FROM ins)::text, '') AS id,\n  CASE\n    WHEN NOT (SELECT owns_property FROM guard) THEN 'not_found'\n    WHEN NOT (SELECT under_limit  FROM guard) THEN 'limit'\n    ELSE ''\n  END AS reason,\n  (SELECT unit_limit FROM guard) AS unit_limit;",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "typeVersion": 2.5,
      "alwaysOutputData": true
    },
