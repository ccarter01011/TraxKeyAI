        "query": "INSERT INTO traxkey.inspection_items (inspection_id, area, item, condition, notes, beyond_normal_wear)\nSELECT '{{ $(\"Add Item (Webhook)\").first().json.body.inspectionId }}'::uuid,\n  trim('{{ (String($(\"Add Item (Webhook)\").first().json.body.area || \"\")).replace(/'/g, \"''\") }}'),\n  trim('{{ (String($(\"Add Item (Webhook)\").first().json.body.item || \"\")).replace(/'/g, \"''\") }}'),\n  '{{ (String($(\"Add Item (Webhook)\").first().json.body.condition || \"\")).replace(/[^a-z]/g, \"\") }}',\n  NULLIF('{{ (String($(\"Add Item (Webhook)\").first().json.body.notes || \"\")).replace(/'/g, \"''\") }}', ''),\n  {{ $(\"Add Item (Webhook)\").first().json.body.beyondNormalWear === true ? 'true' : ($(\"Add Item (Webhook)\").first().json.body.beyondNormalWear === false ? 'false' : 'NULL') }}\nWHERE EXISTS (\n  SELECT 1 FROM traxkey.inspections i\n  WHERE i.id = '{{ $(\"Add Item (Webhook)\").first().json.body.inspectionId }}'::uuid AND i.company_id = '{{ $json.company_id }}'::uuid\n)\nRETURNING id;",
