    {
      "id": "get-inspections",
      "name": "Get Inspections",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        32
      ],
      "typeVersion": 2.5,
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true,
      "parameters": {
        "query": "SELECT i.id, i.inspection_type, i.status, i.notes, i.completed_at, i.created_at,\n  i.unit_id, i.lease_id,\n  u.unit_number, p.name AS property_name,\n  COALESCE(\n    json_agg(json_build_object(\n      'id', it.id, 'area', it.area, 'item', it.item, 'condition', it.condition,\n      'notes', it.notes, 'beyond_normal_wear', it.beyond_normal_wear\n    ) ORDER BY it.area, it.item) FILTER (WHERE it.id IS NOT NULL), '[]'\n  ) AS items\nFROM traxkey.inspections i\nJOIN traxkey.units u ON u.id = i.unit_id\nJOIN traxkey.properties p ON p.id = u.property_id\nLEFT JOIN traxkey.inspection_items it ON it.inspection_id = i.id\nWHERE i.company_id = '{{ $json.company_id }}'\nGROUP BY i.id, u.unit_number, p.name\nORDER BY i.created_at DESC\nLIMIT 100;",
        "options": {},
        "operation": "executeQuery"
      }
    },
