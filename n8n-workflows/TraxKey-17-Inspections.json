      "alwaysOutputData": true,
      "parameters": {
        "query": "INSERT INTO traxkey.inspections (company_id, unit_id, inspection_type, lease_id, turn_id, notes)\nSELECT '{{ $json.company_id }}'::uuid,\n  '{{ $(\"Start Inspection (Webhook)\").first().json.body.unitId }}'::uuid,\n  '{{ (String($(\"Start Inspection (Webhook)\").first().json.body.inspectionType || \"\")).replace(/[^a-z_]/g, \"\") }}',\n  NULLIF('{{ $(\"Start Inspection (Webhook)\").first().json.body.leaseId || \"\" }}', '')::uuid,\n  NULLIF('{{ $(\"Start Inspection (Webhook)\").first().json.body.turnId || \"\" }}', '')::uuid,\n  NULLIF('{{ (String($(\"Start Inspection (Webhook)\").first().json.body.notes || \"\")).replace(/'/g, \"''\") }}', '')\nWHERE EXISTS (\n  SELECT 1 FROM traxkey.units u JOIN traxkey.properties p ON p.id = u.property_id\n  WHERE u.id = '{{ $(\"Start Inspection (Webhook)\").first().json.body.unitId }}'::uuid\n    AND p.company_id = '{{ $json.company_id }}'::uuid\n)\nRETURNING id;",
