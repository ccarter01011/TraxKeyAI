      "typeVersion": 2.5,
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "options": {},
        "query": "SELECT\n  COALESCE(r.requires_human_review, false) AS requires_human_review,\n  c.name AS company_name,\n  (SELECT u.email FROM traxkey.users u WHERE u.company_id = c.id ORDER BY u.created_at LIMIT 1) AS contact_email\nFROM traxkey.residents r\nJOIN traxkey.units u2 ON u2.id = r.unit_id\nJOIN traxkey.properties p ON p.id = u2.property_id\nJOIN traxkey.companies c ON c.id = p.company_id\nWHERE r.access_token = '{{ $json.body.token ? $json.body.token.replace(/[^a-zA-Z0-9]/g, \"\") : \"\" }}';"
      }
