      "name": "Insert Maintenance Request",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        464
      ],
      "notes": "unit_id and resident_id are both known here, unlike the company-code fallback path, no address-matching gap for these submissions.",
      "parameters": {
        "query": "INSERT INTO traxkey.maintenance_requests (company_id, unit_id, resident_id, description, urgency, submitter_name, submitter_phone, status)\nVALUES (\n  '{{ $json.company_id }}', '{{ $json.unit_id }}', '{{ $json.resident_id }}',\n  '{{ $(\"Resident Intake (Webhook)\").first().json.body.description.replace(/'/g, \"''\") }}',\n  '{{ $(\"Resident Intake (Webhook)\").first().json.body.urgency.replace(/'/g, \"''\") }}',\n  '{{ $json.name.replace(/'/g, \"''\") }}',\n  {{ $json.phone ? \"'\" + $json.phone.replace(/'/g, \"''\") + \"'\" : 'NULL' }},\n  'submitted'\n)\nRETURNING id;",
        "options": {},
        "operation": "executeQuery"
