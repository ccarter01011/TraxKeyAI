    {
      "id": "cr-insert",
      "name": "Insert Resident",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        288
      ],
      "notes": "WHERE EXISTS checks the unit belongs (via its property) to the caller's own company, same tenant-isolation pattern as Insert Unit.",
      "parameters": {
        "query": "INSERT INTO traxkey.residents (unit_id, name, email, phone)\nSELECT\n  '{{ $(\"Create Resident (Webhook)\").first().json.body.unitId }}',\n  '{{ $(\"Create Resident (Webhook)\").first().json.body.name.replace(/'/g, \"''\") }}',\n  {{ $(\"Create Resident (Webhook)\").first().json.body.email ? \"'\" + $(\"Create Resident (Webhook)\").first().json.body.email.replace(/'/g, \"''\") + \"'\" : 'NULL' }},\n  {{ $(\"Create Resident (Webhook)\").first().json.body.phone ? \"'\" + $(\"Create Resident (Webhook)\").first().json.body.phone.replace(/'/g, \"''\") + \"'\" : 'NULL' }}\nWHERE EXISTS (\n  SELECT 1 FROM traxkey.units u\n  JOIN traxkey.properties p ON p.id = u.property_id\n  WHERE u.id = '{{ $(\"Create Resident (Webhook)\").first().json.body.unitId }}'\n  AND p.company_id = '{{ $json.company_id }}'\n)\nRETURNING id, access_token;",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
