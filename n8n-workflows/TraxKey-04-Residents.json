        "query": "SELECT\n  false AS requires_human_review,\n  c.name AS company_name,\n  (SELECT u.email FROM traxkey.users u WHERE u.company_id = c.id ORDER BY u.created_at LIMIT 1) AS contact_email\nFROM traxkey.companies c\nWHERE c.portal_slug = '{{ $json.body.portalSlug ? $json.body.portalSlug.replace(/[^a-zA-Z0-9]/g, \"\") : \"\" }}';"
