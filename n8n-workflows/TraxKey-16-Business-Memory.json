      "alwaysOutputData": true,
      "parameters": {
        "query": "INSERT INTO traxkey.business_memory (company_id, rule_type, scope, scope_ref, value, note, created_by)\nSELECT '{{ $json.company_id }}'::uuid,\n  '{{ (String($(\"Set Rule (Webhook)\").first().json.body.ruleType || \"\")).replace(/[^a-z_]/g, \"\") }}',\n  '{{ (String($(\"Set Rule (Webhook)\").first().json.body.scope || \"global\")).replace(/[^a-z]/g, \"\") }}',\n  NULLIF('{{ (String($(\"Set Rule (Webhook)\").first().json.body.scopeRef || \"\")).replace(/'/g, \"''\") }}', ''),\n  trim('{{ (String($(\"Set Rule (Webhook)\").first().json.body.value || \"\")).replace(/'/g, \"''\") }}'),\n  NULLIF('{{ (String($(\"Set Rule (Webhook)\").first().json.body.note || \"\")).replace(/'/g, \"''\") }}', ''),\n  NULL\nWHERE '{{ (String($(\"Set Rule (Webhook)\").first().json.body.scope || \"global\")).replace(/[^a-z]/g, \"\") }}' = 'global'\n   OR NULLIF('{{ (String($(\"Set Rule (Webhook)\").first().json.body.scopeRef || \"\")).replace(/'/g, \"''\") }}', '') IS NOT NULL\nON CONFLICT (company_id, rule_type, scope, COALESCE(scope_ref, ''))\nDO UPDATE SET value = EXCLUDED.value, note = EXCLUDED.note, updated_at = now()\nRETURNING id;",
        "options": {},
        "operation": "executeQuery"
