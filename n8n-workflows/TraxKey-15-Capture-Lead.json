{
  "name": "TraxKey-15-Capture-Lead",
  "nodes": [
    {
      "id": "capture-lead-webhook",
      "name": "Capture Lead (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "position": [
        -320,
        32
      ],
      "typeVersion": 2,
      "webhookId": "traxkey-capture-lead",
      "parameters": {
        "path": "traxkey-capture-lead",
        "options": {
          "allowedOrigins": "*"
        },
        "httpMethod": "POST",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "insert-lead",
      "name": "Insert Lead",
      "type": "n8n-nodes-base.postgres",
      "position": [
        -96,
        32
      ],
      "typeVersion": 2.5,
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "options": {},
        "query": "INSERT INTO traxkey.leads (name, email, company, portfolio_size, message, source)\nSELECT\n  trim('{{ (String($json.body.name || \"\")).replace(/'/g, \"''\") }}'),\n  trim('{{ (String($json.body.email || \"\")).replace(/'/g, \"''\") }}'),\n  NULLIF('{{ (String($json.body.company || \"\")).replace(/'/g, \"''\") }}', ''),\n  NULLIF('{{ (String($json.body.portfolioSize || \"\")).replace(/'/g, \"''\") }}', ''),\n  NULLIF('{{ (String($json.body.message || \"\")).replace(/'/g, \"''\") }}', ''),\n  NULLIF('{{ (String($json.body.source || \"\")).replace(/'/g, \"''\") }}', '')\nRETURNING id;"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "lead-saved",
      "name": "Lead Saved?",
      "type": "n8n-nodes-base.if",
      "position": [
        128,
        32
      ],
      "typeVersion": 2,
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "leftValue": "={{ $json.id }}",
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "respond-saved",
      "name": "Respond: Lead Saved",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        352,
        32
      ],
      "typeVersion": 1,
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={ \"success\": true }"
      }
    },
    {
      "id": "respond-invalid",
      "name": "Respond: Invalid Lead",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        352,
        180
      ],
      "typeVersion": 1,
      "parameters": {
        "options": {
          "responseCode": 400
        },
        "respondWith": "json",
        "responseBody": "={ \"error\": \"Name and email are required.\" }"
      }
    }
  ],
  "connections": {
