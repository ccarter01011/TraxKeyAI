      "alwaysOutputData": true
    },
    {
      "id": "sv-activity",
      "name": "Session Valid? (Activity)",
      "type": "n8n-nodes-base.if",
      "position": [
        128,
        32
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
