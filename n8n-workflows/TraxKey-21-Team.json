    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO traxkey.users (company_id, email, password_hash, name, role, reset_token, reset_token_expires_at)\nVALUES ('{{ $json.companyId }}', '{{ $json.email.replace(/'/g, \"''\") }}', crypt('{{ $json.randomPassword }}', gen_salt('bf')), '{{ $json.name.replace(/'/g, \"''\") }}', '{{ $json.role }}', '{{ $json.inviteToken }}', '{{ $json.expiresAt }}')\nRETURNING id;",
        "options": {}
      },
