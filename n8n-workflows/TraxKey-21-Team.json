    {
      "parameters": {
        "jsCode": "const isUuid = v => typeof v === 'string' && /^[0-9a-fA-F-]{36}$/.test(v);\nconst allowedRoles = ['owner', 'ops_manager', 'staff'];\nconst body = $('Update Role (Webhook)').first().json.body;\nif (!isUuid(body.userId)) throw new Error('Invalid userId');\nif (!allowedRoles.includes(body.role)) throw new Error('Invalid role');\nreturn [{ json: { ...$json, userId: body.userId, role: body.role } }];"
      },
