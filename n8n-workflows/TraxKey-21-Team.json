    {
      "parameters": {
        "jsCode": "const randomPassword = Array.from({ length: 32 }, () => Math.random().toString(36)[2] || '0').join('');\nconst inviteToken = Array.from({ length: 32 }, () => Math.random().toString(36)[2] || '0').join('');\nconst expiresAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString();\n\nconst owner = $('Verify Requester Is Owner (Add)').first().json;\nconst body = $('Add User (Webhook)').first().json.body;\nconst role = ['owner', 'ops_manager', 'staff'].includes(body.role) ? body.role : 'staff';\n\nreturn [{\n  json: {\n    randomPassword, inviteToken, expiresAt,\n    companyId: owner.company_id, companyName: owner.company_name, inviterName: owner.inviter_name,\n    name: body.name, email: body.email.toLowerCase(), role,\n  }\n}];"
      },
      "id": "7a9d2cae-e40e-48ee-ae41-f0f851194fa8",
