    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE traxkey.companies SET stripe_customer_id = '{{ $json.id }}' WHERE id = '{{ $('Validate Session (Checkout)').first().json.company_id }}'\nRETURNING stripe_customer_id;",
        "options": {},
        "alwaysOutputData": null
