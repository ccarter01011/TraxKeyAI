      "id": "5a5b4c1b-8c1a-4f2a-a24b-94e656f04e74",
      "name": "Mark Checkout Complete",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        660,
        460
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Syncs plan_status from Stripe's actual subscription status whenever it\n-- changes (payment failure, recovery, etc). Only maps the 3 states\n-- actively used here; anything else (canceled/unpaid/incomplete) is left\n-- as-is since true cancellation is handled by Sync Subscription Cancelled.\nUPDATE traxkey.companies\nSET stripe_subscription_id = '{{ $json.data.object.id }}',\n    plan_status = CASE '{{ $json.data.object.status }}'\n      WHEN 'active' THEN 'active'\n      WHEN 'past_due' THEN 'past_due'\n      WHEN 'trialing' THEN 'trialing'\n      ELSE plan_status\n    END\nWHERE stripe_customer_id = '{{ $json.data.object.customer }}';",
        "options": {},
        "alwaysOutputData": null
      },
      "id": "396fd16c-ff81-4a4e-a9e1-5494bf6df901",
      "name": "Sync Subscription Updated",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        660,
        600
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE traxkey.companies SET plan = 'free', plan_status = 'cancelled', cancelled_at = now(), stripe_subscription_id = NULL WHERE stripe_customer_id = '{{ $json.data.object.customer }}';",
        "options": {},
        "alwaysOutputData": null
      },
      "id": "d7999b1d-08ae-474b-8804-ff8d6ee8e018",
      "name": "Sync Subscription Cancelled",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        660,
        740
      ],
      "alwaysOutputData": true
    },
