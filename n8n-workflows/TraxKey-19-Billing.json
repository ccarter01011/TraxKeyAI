        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "mode",
              "value": "subscription"
            },
            {
              "name": "customer",
              "value": "={{ $json.customerId }}"
            },
            {
              "name": "line_items[0][price]",
              "value": "={{ $json.priceId }}"
            },
            {
              "name": "line_items[0][quantity]",
              "value": "1"
            },
            {
              "name": "success_url",
              "value": "https://app.traxkey.ai/?checkout=success"
            },
            {
              "name": "cancel_url",
              "value": "https://app.traxkey.ai/pricing?checkout=cancelled"
            },
            {
              "name": "metadata[company_id]",
              "value": "={{ $json.companyId }}"
            },
            {
              "name": "metadata[plan]",
