    {
      "parameters": {
        "jsCode": "// Flat monthly tiers, no metering. Price IDs are the TraxKey AI Stripe\n// sandbox's recurring prices for Starter/Growth/Pro (schema_v39 backs the\n// stripe_customer_id/stripe_subscription_id columns this workflow reads\n// and writes).\nconst priceMap = {\n  starter: 'price_1U6BUbH92vZ4jbike51YIZz0',\n  growth: 'price_1U6BWCH92vZ4jbikW6evfxAi',\n  pro: 'price_1U6BXAH92vZ4jbikMcUFLwsb',\n};\n\nconst body = $('Create Checkout (Webhook)').first().json.body;\nconst plan = (body.plan || '').toLowerCase();\nconst priceId = priceMap[plan];\nif (!priceId) throw new Error(`Unknown plan: ${plan}`);\n\nconst session = $('Validate Session (Checkout)').first().json;\n\n// $('NodeName') throws when that node never ran in this execution (e.g.\n// 'Stripe: Create Customer' on the existing-customer branch, where it's\n// skipped). Each lookup is its own try/catch so a miss on one never\n// crashes the other, working branch. Mirrors the fix already shipped in\n// TraxSail's Billing workflow after the same bug reached production there.\nlet customerId;\ntry {\n  customerId = $('Has Stripe Customer?').first()?.json?.stripe_customer_id;\n} catch (e) {}\nif (!customerId) {\n  try {\n    customerId = $('Stripe: Create Customer').first()?.json?.id;\n  } catch (e) {}\n}\nif (!customerId) throw new Error('Could not determine Stripe customer id for checkout.');\n\nreturn [{ json: { customerId, priceId, companyId: session.company_id, plan } }];\n"
      },
      "id": "fb2a0ec6-2dbf-4fe4-b9fc-1372a5a22cdd",
      "name": "Build Checkout Params",
