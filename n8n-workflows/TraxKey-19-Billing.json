        "query": "UPDATE traxkey.companies\nSET plan = '{{ $json.data.object.metadata.plan }}',\n    plan_status = 'active',\n    stripe_subscription_id = '{{ $json.data.object.subscription }}'\nWHERE id = '{{ $json.data.object.metadata.company_id }}';",
        "options": {},
        "alwaysOutputData": null
