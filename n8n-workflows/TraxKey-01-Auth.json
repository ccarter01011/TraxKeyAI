{
  "name": "TraxKey - 01 Auth",
  "nodes": [
    {
      "id": "tk-signup-webhook",
      "name": "Signup (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "position": [
        320,
        32
      ],
      "webhookId": "traxkey-signup",
      "parameters": {
        "path": "traxkey-signup",
        "options": {
          "allowedOrigins": "*"
        },
        "httpMethod": "POST",
        "responseMode": "responseNode"
      },
      "typeVersion": 2.1
    },
    {
      "id": "tk-create-company-user",
      "name": "Create Company + Owner User",
      "type": "n8n-nodes-base.postgres",
      "position": [
        560,
        32
      ],
      "notes": "pgcrypto's crypt()+gen_salt('bf') hashes the password directly in Postgres, same proven pattern as TraxSail's auth workflow, no JS hashing library needed in n8n's sandboxed Code node.",
      "parameters": {
        "query": "WITH new_company AS (\n  INSERT INTO traxkey.companies (name, tracking_email)\n  VALUES ('{{ $json.body.companyName.replace(/'/g, \"''\") }}', '{{ $json.body.email.toLowerCase().replace(/'/g, \"''\") }}')\n  RETURNING id\n),\nnew_user AS (\n  INSERT INTO traxkey.users (company_id, email, password_hash, name, role)\n  SELECT new_company.id, '{{ $json.body.email.toLowerCase().replace(/'/g, \"''\") }}', crypt('{{ $json.body.password.replace(/'/g, \"''\") }}', gen_salt('bf')), '{{ $json.body.name.replace(/'/g, \"''\") }}', 'owner'\n  FROM new_company\n  RETURNING id, company_id\n)\nSELECT id AS user_id, company_id FROM new_user;",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "typeVersion": 2.5
    },
    {
      "id": "tk-gen-session-token",
      "name": "Generate Session Token",
      "type": "n8n-nodes-base.code",
      "position": [
        800,
        32
      ],
      "parameters": {
        "jsCode": "const token = Array.from({ length: 48 }, () => Math.random().toString(36)[2] || '0').join('');\nconst expiresAt = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString();\nreturn [{ json: { ...$json, token, expiresAt } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "tk-create-session",
      "name": "Create Session",
      "type": "n8n-nodes-base.postgres",
      "position": [
        1040,
        32
      ],
      "parameters": {
        "query": "INSERT INTO traxkey.sessions (token, user_id, company_id, expires_at)\nVALUES ('{{ $json.token }}', '{{ $json.user_id }}', '{{ $json.company_id }}', '{{ $json.expiresAt }}');",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "typeVersion": 2.5
    },
    {
      "id": "tk-respond-signup-ok",
      "name": "Respond: Signup OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        1280,
        32
      ],
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, token: $('Generate Session Token').item.json.token }) }}"
      },
      "typeVersion": 1.1
    },
    {
      "id": "tk-login-webhook",
      "name": "Login (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "position": [
        320,
        320
      ],
      "webhookId": "traxkey-login",
      "parameters": {
        "path": "traxkey-login",
        "options": {
          "allowedOrigins": "*"
        },
        "httpMethod": "POST",
        "responseMode": "responseNode"
      },
      "typeVersion": 2.1
    },
    {
      "id": "tk-verify-login",
      "name": "Verify Login",
      "type": "n8n-nodes-base.postgres",
      "position": [
        560,
        320
      ],
      "notes": "crypt(input, stored_hash) = stored_hash is the standard pgcrypto verification pattern, recomputes using the embedded salt and compares.",
      "parameters": {
        "query": "SELECT id AS user_id, company_id, name, role\nFROM traxkey.users\nWHERE email = '{{ $json.body.email.toLowerCase().replace(/'/g, \"''\") }}'\nAND password_hash = crypt('{{ $json.body.password.replace(/'/g, \"''\") }}', password_hash);",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "typeVersion": 2.5,
      "alwaysOutputData": true
    },
    {
      "id": "tk-login-valid-if",
      "name": "Login Valid?",
      "type": "n8n-nodes-base.if",
