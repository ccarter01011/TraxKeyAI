    {
      "id": "gt-get",
      "name": "Get Turns",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        32
      ],
      "notes": "days_vacant covers both an in-progress turn (now() - start) and a finished one (unit_ready_at - start), same generalized abstraction the turns table was designed around: a vacancy-to-ready cycle regardless of whether it's an annual LTR turnover or a same-week STR clean.",
      "parameters": {
        "query": "SELECT t.id, t.status, t.turn_type, t.auto_created, t.deadline_at, t.vacancy_started_at, t.inspection_completed_at, t.unit_ready_at, t.total_cost,\n  u.unit_number, p.name AS property_name,\n  r.name AS new_resident_name,\n  EXTRACT(DAY FROM (COALESCE(t.unit_ready_at, now()) - t.vacancy_started_at))::int AS days_vacant,\n  COALESCE(\n    json_agg(json_build_object(\n      'id', mr.id, 'description', mr.description, 'status', mr.status, 'category', mr.category,\n      'final_cost', mr.final_cost, 'quoted_cost', mr.quoted_cost, 'vendor_name', v.name\n    ) ORDER BY mr.created_at)\n    FILTER (WHERE mr.id IS NOT NULL), '[]'\n  ) AS repairs\nFROM traxkey.turns t\nJOIN traxkey.units u ON u.id = t.unit_id\nJOIN traxkey.properties p ON p.id = u.property_id\nLEFT JOIN traxkey.residents r ON r.id = t.new_resident_id\nLEFT JOIN traxkey.maintenance_requests mr ON mr.turn_id = t.id\nLEFT JOIN traxkey.vendors v ON v.id = mr.assigned_vendor_id\nWHERE t.company_id = '{{ $json.company_id }}'\nGROUP BY t.id, u.unit_number, p.name, r.name\nORDER BY t.vacancy_started_at DESC\nLIMIT 100;",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "typeVersion": 2.5,
      "alwaysOutputData": true
    },
