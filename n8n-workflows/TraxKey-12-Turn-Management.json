    {
      "id": "at-update",
      "name": "Update Turn Status",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        620
      ],
      "notes": "Recomputes total_cost from linked repairs on every call, cheap and always correct, rather than trying to track a running total. inspection_completed_at/unit_ready_at only get set the first time their status is reached (CASE preserves the existing value otherwise), so re-advancing doesn't overwrite an earlier real timestamp.",
      "parameters": {
        "query": "UPDATE traxkey.turns t\nSET status = '{{ $(\"Advance Turn (Webhook)\").first().json.body.newStatus.replace(/'/g, \"''\") }}',\n  inspection_completed_at = CASE WHEN '{{ (String($(\"Advance Turn (Webhook)\").first().json.body.newStatus || \"\")).replace(/[^a-zA-Z0-9._:-]/g, \"\") }}' = 'repairs_in_progress' AND t.inspection_completed_at IS NULL THEN now() ELSE t.inspection_completed_at END,\n  unit_ready_at = CASE WHEN '{{ (String($(\"Advance Turn (Webhook)\").first().json.body.newStatus || \"\")).replace(/[^a-zA-Z0-9._:-]/g, \"\") }}' = 'ready' AND t.unit_ready_at IS NULL THEN now() ELSE t.unit_ready_at END,\n  new_resident_id = {{ $(\"Advance Turn (Webhook)\").first().json.body.newResidentId ? \"'\" + String($(\"Advance Turn (Webhook)\").first().json.body.newResidentId).replace(/[^a-zA-Z0-9-]/g, \"\") + \"'\" : 't.new_resident_id' }},\n  total_cost = (SELECT COALESCE(SUM(mr.final_cost), 0) FROM traxkey.maintenance_requests mr WHERE mr.turn_id = t.id)\nFROM traxkey.units u, traxkey.properties p\nWHERE t.id = '{{ (String($(\"Advance Turn (Webhook)\").first().json.body.turnId || \"\")).replace(/[^a-zA-Z0-9._:-]/g, \"\") }}'\nAND u.id = t.unit_id AND p.id = u.property_id\nAND p.company_id = '{{ $json.company_id }}'\nRETURNING t.id, t.status, t.unit_id;",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "typeVersion": 2.5,
      "alwaysOutputData": true
    },
