    {
      "id": "st-insert",
      "name": "Insert Turn",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        300
      ],
      "notes": "WHERE EXISTS checks two things: the unit belongs to the caller's company, AND there's no already-active turn for it (any status other than 'occupied'). Prevents starting a second turn on a unit that's mid-turn.",
      "parameters": {
        "query": "INSERT INTO traxkey.turns (company_id, unit_id)\nSELECT '{{ $json.company_id }}', '{{ (String($(\"Start Turn (Webhook)\").first().json.body.unitId || \"\")).replace(/[^a-zA-Z0-9._:-]/g, \"\") }}'\nWHERE EXISTS (\n  SELECT 1 FROM traxkey.units u JOIN traxkey.properties p ON p.id = u.property_id\n  WHERE u.id = '{{ (String($(\"Start Turn (Webhook)\").first().json.body.unitId || \"\")).replace(/[^a-zA-Z0-9._:-]/g, \"\") }}' AND p.company_id = '{{ $json.company_id }}'\n)\nAND NOT EXISTS (\n  SELECT 1 FROM traxkey.turns WHERE unit_id = '{{ (String($(\"Start Turn (Webhook)\").first().json.body.unitId || \"\")).replace(/[^a-zA-Z0-9._:-]/g, \"\") }}' AND status != 'occupied'\n)\nRETURNING id;",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
