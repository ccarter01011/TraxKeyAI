    {
      "id": "ctr-insert",
      "name": "Insert Turn Repair",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        940
      ],
      "notes": "First property-manager-initiated maintenance_requests row, every prior one came from a tenant/guest via intake or resident-intake. unit_id and company_id are derived from the turn itself, not passed in the body, so this can't be pointed at a unit outside the caller's own turn.",
      "parameters": {
        "query": "INSERT INTO traxkey.maintenance_requests (company_id, unit_id, turn_id, description, urgency, submitter_name, status)\nSELECT t.company_id, t.unit_id, t.id,\n  '{{ $(\"Create Turn Repair (Webhook)\").first().json.body.description.replace(/'/g, \"''\") }}',\n  '{{ (String($(\"Create Turn Repair (Webhook)\").first().json.body.urgency || \"routine\")).replace(/[^a-zA-Z0-9._:-]/g, \"\") }}',\n  'Property Manager', 'submitted'\nFROM traxkey.turns t\nWHERE t.id = '{{ (String($(\"Create Turn Repair (Webhook)\").first().json.body.turnId || \"\")).replace(/[^a-zA-Z0-9._:-]/g, \"\") }}'\nAND t.company_id = '{{ $json.company_id }}'\nRETURNING id;",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
