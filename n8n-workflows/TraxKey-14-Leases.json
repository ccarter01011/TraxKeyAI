      "alwaysOutputData": true,
      "parameters": {
        "query": "INSERT INTO traxkey.leases\n  (unit_id, start_date, end_date, rent_amount, deposit_amount, rent_due_day, notice_days, status, renewal_status)\nSELECT '{{ $(\"Create Lease (Webhook)\").first().json.body.unitId }}'::uuid,\n  '{{ $(\"Create Lease (Webhook)\").first().json.body.startDate }}'::date,\n  NULLIF('{{ $(\"Create Lease (Webhook)\").first().json.body.endDate || \"\" }}', '')::date,\n  NULLIF('{{ $(\"Create Lease (Webhook)\").first().json.body.rentAmount || \"\" }}', '')::numeric,\n  NULLIF('{{ $(\"Create Lease (Webhook)\").first().json.body.depositAmount || \"\" }}', '')::numeric,\n  COALESCE(NULLIF('{{ $(\"Create Lease (Webhook)\").first().json.body.rentDueDay || \"\" }}', '')::smallint, 1),\n  COALESCE(NULLIF('{{ $(\"Create Lease (Webhook)\").first().json.body.noticeDays || \"\" }}', '')::smallint, 30),\n  'active', 'none'\n-- Tenant isolation: the unit must belong to the caller's company. Without this\n-- any signed-in user could attach a lease to somebody else's property.\nWHERE EXISTS (\n  SELECT 1 FROM traxkey.units u JOIN traxkey.properties p ON p.id = u.property_id\n  WHERE u.id = '{{ $(\"Create Lease (Webhook)\").first().json.body.unitId }}'::uuid AND p.company_id = '{{ $json.company_id }}'::uuid\n)\nRETURNING id, unit_id, start_date, end_date;",
