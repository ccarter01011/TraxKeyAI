      "alwaysOutputData": true,
      "parameters": {
        "query": "SELECT l.id, l.unit_id, l.start_date, l.end_date, l.rent_amount, l.deposit_amount,\n  l.rent_due_day, l.notice_days, l.status, l.renewal_status, l.renewal_offered_at,\n  l.renewal_rent_amount, l.ended_at, l.end_reason,\n  u.unit_number, p.name AS property_name,\n  (SELECT r.name FROM traxkey.residents r\n    WHERE r.lease_id = l.id AND r.is_active ORDER BY r.created_at LIMIT 1) AS resident_name\nFROM traxkey.leases l\nJOIN traxkey.units u ON u.id = l.unit_id\nJOIN traxkey.properties p ON p.id = u.property_id\nWHERE p.company_id = '{{ $json.company_id }}' AND l.status <> 'ended'\nORDER BY l.end_date NULLS LAST, p.name;",
        "options": {},
        "operation": "executeQuery"
      }
