        "query": "SELECT v.id, v.name, v.trade, v.contact_email, v.contact_phone, v.emergency_available,\n  vp.jobs_completed, vp.avg_response_hours, vp.avg_cost, vp.completion_rate, vp.avg_rating\nFROM traxkey.vendors v\nLEFT JOIN traxkey.vendor_performance vp ON vp.vendor_id = v.id\nWHERE v.company_id = '{{ $json.company_id }}'\nORDER BY v.trade, v.name;",
