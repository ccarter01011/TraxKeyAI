            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond: Invalid Portal Link",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert Maintenance Request": {
      "main": [
        [
          {
            "node": "Log Submitted Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Submitted Event": {
      "main": [
        [
          {
            "node": "Respond: Intake OK",
