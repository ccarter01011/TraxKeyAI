      ],
      "parameters": {
        "query": "INSERT INTO traxkey.maintenance_events (request_id, event_type, content) VALUES ('{{ $json.id }}', 'closed', 'Marked complete by a team member.');",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
