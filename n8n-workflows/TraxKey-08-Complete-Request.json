    {
      "id": "cr-upsert-perf",
      "name": "Update Vendor Performance",
      "type": "n8n-nodes-base.postgres",
      "position": [
        800,
        -48
      ],
      "notes": "Rolling average over jobs_completed. completion_rate is simplified to 100 on every completion for v1, a true rate (completed vs. ever-dispatched) needs a dispatch counter this schema doesn't track yet.",
      "parameters": {
        "query": "INSERT INTO traxkey.vendor_performance (vendor_id, jobs_completed, avg_cost, completion_rate, avg_rating, updated_at)\nVALUES (\n  '{{ $json.assigned_vendor_id }}', 1,\n  {{ $json.final_cost || 0 }}, 100,\n  {{ $json.resident_rating || 'NULL' }}, now()\n)\nON CONFLICT (vendor_id) DO UPDATE SET\n  jobs_completed = traxkey.vendor_performance.jobs_completed + 1,\n  avg_cost = ((COALESCE(traxkey.vendor_performance.avg_cost, 0) * traxkey.vendor_performance.jobs_completed) + {{ $json.final_cost || 0 }}) / (traxkey.vendor_performance.jobs_completed + 1),\n  avg_rating = CASE WHEN {{ $json.resident_rating || 'NULL' }} IS NOT NULL THEN\n    ((COALESCE(traxkey.vendor_performance.avg_rating, {{ $json.resident_rating || 0 }}) * traxkey.vendor_performance.jobs_completed) + {{ $json.resident_rating || 0 }}) / (traxkey.vendor_performance.jobs_completed + 1)\n  ELSE traxkey.vendor_performance.avg_rating END,\n  completion_rate = 100,\n  updated_at = now();",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "typeVersion": 2.5
    },
    {
