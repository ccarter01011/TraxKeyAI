    {
      "id": "cr-update",
      "name": "Mark Request Completed",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        32
      ],
      "notes": "Only touches this company's own request, and only if it's actually in a dispatched state, can't complete something still awaiting approval or already closed.",
      "parameters": {
        "query": "UPDATE traxkey.maintenance_requests\nSET status = 'completed', final_cost = {{ $(\"Complete Request (Webhook)\").first().json.body.finalCost || 'NULL' }},\n  resident_rating = {{ $(\"Complete Request (Webhook)\").first().json.body.rating || 'NULL' }}, closed_at = now()\nWHERE id = '{{ $(\"Complete Request (Webhook)\").first().json.body.requestId }}'\nAND company_id = '{{ $json.company_id }}'\nAND status IN ('scheduled', 'in_progress')\nRETURNING id, assigned_vendor_id, final_cost, resident_rating;",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "typeVersion": 2.5,
      "alwaysOutputData": true
    },
