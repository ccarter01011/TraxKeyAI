      "parameters": {
        "jsCode": "// Resend's inbound webhook payload is metadata only, no body/attachments.\n// This just extracts routing info; the actual text gets fetched next.\nconst body = $json.body || {};\nif (body.type !== 'email.received') {\n  return [];\n}\nconst data = body.data || {};\nreturn [{\n  json: {\n    emailId: data.email_id || data.id || '',\n    toAddress: (data.to && data.to[0]) || '',\n    fromAddress: data.from || '',\n    subject: data.subject || ''\n  }\n}];"
      },
      "id": "74c64c32-a677-405e-9ecd-c8ff54ad87a8",
      "name": "Parse Resend Payload",
