    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE traxkey.maintenance_requests\nSET vendor_acknowledged_at = CASE WHEN '{{ $json.classification }}' = 'confirmed' THEN now() ELSE vendor_acknowledged_at END\nWHERE id = '{{ $json.recordId }}';",
        "options": {}
      },
      "id": "d70ffa95-465c-41f0-bbe9-6446125925a3",
      "name": "Update MR From Reply",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1648,
        864
      ],
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "notes": "Only ever sets vendor_acknowledged_at, which is exactly the field the existing chase-eligibility index already checks (mr_chase_idx: status='scheduled' AND vendor_acknowledged_at IS NULL), so a confirmed reply stops future chasing with no new logic needed elsewhere."
    },
