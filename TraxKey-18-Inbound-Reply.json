        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 300, temperature: 0, system: 'You classify short reply emails for a property management chase system. Be terse and literal, never infer more than the text supports.', messages: [ { role: 'user', content: $json.prompt } ] }) }}",
        "options": {
          "timeout": 30000
