    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE traxkey.ordered_items\nSET expected_on = {{ $json.newExpectedDate ? \"'\" + $json.newExpectedDate + \"'\" : 'expected_on' }},\n    status = CASE WHEN '{{ $json.classification }}' = 'received' THEN 'received' ELSE status END,\n    received_on = CASE WHEN '{{ $json.classification }}' = 'received' THEN COALESCE({{ $json.newExpectedDate ? \"'\" + $json.newExpectedDate + \"'\" : 'NULL' }}, CURRENT_DATE) ELSE received_on END\nWHERE id = '{{ $json.recordId }}';",
