    {
      "parameters": {
        "jsCode": "const rec = $json;\nconst reply = $('Combine Routing + Full Body').first().json;\nconst prompt = `A vendor replied to a job-assignment follow-up email for a property maintenance request.\n\nJob: ${rec.description}\nCategory: ${rec.category || 'unspecified'}\n\nReply: ${reply.bodyText.slice(0, 2000)}\n\nRespond with ONLY a JSON object (no markdown, no prose):\n{ \"classification\": \"confirmed\" | \"declined\" | \"other\", \"summary\": \"1 sentence plain-English summary of what the vendor said\" }`;\nreturn [{ json: { prompt, recordId: rec.id } }];"
      },
      "id": "a7cf597f-bd03-4eef-b154-af138d1cb41b",
      "name": "Build MR Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
