    {
      "parameters": {
        "jsCode": "const raw = $json.content?.[0]?.text || '';\nconst cleaned = raw.replace(/```json/gi,'').replace(/```/g,'').trim();\nconst match = cleaned.match(/\\{[\\s\\S]*\\}/);\nif (!match) throw new Error('No JSON in Claude response: ' + raw.slice(0,300));\nconst parsed = JSON.parse(match[0]);\nconst source = $('Build MR Prompt').first().json;\nreturn [{ json: { recordId: source.recordId, classification: parsed.classification || 'other', summary: parsed.summary || '' } }];"
      },
