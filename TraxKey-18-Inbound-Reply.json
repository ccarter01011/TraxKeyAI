    {
      "parameters": {
        "jsCode": "// Combines routing info with the fetched body, and pulls the record type\n// + id straight out of the plus-addressed reply-to tag\n// (reply+mr-<uuid>@notify.traxkey.ai, oi- or inv- for the other two record\n// types). This is the entire matching mechanism, deliberately no fuzzy\n// sender/subject matching: the tag is unambiguous, so matching stays SQL\n// -equivalent (a regex), never something Claude has to guess.\nconst routing = $('Parse Resend Payload').first().json;\nconst full = $json;\nconst bodyText = full.text || full.html || '';\n\nconst m = routing.toAddress.match(/reply\\+(mr|oi|inv)-([0-9a-fA-F-]{36})@/);\n\nreturn [{\n  json: {\n    ...routing,\n    bodyText,\n    recordType: m ? m[1] : null,\n    recordId: m ? m[2] : null\n  }\n}];"
      },
      "id": "474682bb-15fd-445f-bd2e-0b44a6316a7a",
      "name": "Combine Routing + Full Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        1136
      ]
    },
