{
  "name": "TraxKey - 10 Password Reset",
  "nodes": [
    {
      "id": "rr-webhook",
      "name": "Request Reset (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "position": [
        -320,
        32
      ],
      "webhookId": "traxkey-request-reset",
      "parameters": {
        "path": "traxkey-request-reset",
        "options": {
          "allowedOrigins": "*"
        },
        "httpMethod": "POST",
        "responseMode": "responseNode"
      },
      "typeVersion": 2.1
    },
    {
      "id": "rr-find",
      "name": "Find User By Email",
      "type": "n8n-nodes-base.postgres",
      "position": [
        -96,
        32
      ],
      "parameters": {
        "query": "SELECT id, name FROM traxkey.users WHERE email = '{{ $json.body.email.toLowerCase().replace(/'/g, \"''\") }}';",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "typeVersion": 2.5,
      "alwaysOutputData": true
    },
    {
      "id": "rr-if",
      "name": "User Found?",
      "type": "n8n-nodes-base.if",
      "position": [
        128,
        32
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "uf",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "leftValue": "={{ $json.id }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2
    },
    {
      "id": "rr-gen-token",
      "name": "Generate Reset Token",
      "type": "n8n-nodes-base.code",
      "position": [
        352,
        -48
      ],
      "parameters": {
        "jsCode": "const token = Array.from({ length: 32 }, () => Math.random().toString(36)[2] || '0').join('');\nconst expiresAt = new Date(Date.now() + 60 * 60 * 1000).toISOString(); // 1 hour\nreturn [{ json: { ...$json, token, expiresAt } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "rr-save-token",
      "name": "Save Reset Token",
      "type": "n8n-nodes-base.postgres",
      "position": [
        576,
        -48
      ],
      "parameters": {
        "query": "UPDATE traxkey.users SET reset_token = '{{ $json.token }}', reset_token_expires_at = '{{ $json.expiresAt }}' WHERE id = '{{ $json.id }}';",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "typeVersion": 2.5
    },
    {
      "id": "rr-send-email",
      "name": "Send Reset Email",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        800,
        -48
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "from",
              "value": "TraxKey AI <dispatch@notify.traxkey.ai>"
            },
            {
              "name": "to",
              "value": "={{ $('Request Reset (Webhook)').first().json.body.email }}"
            },
            {
              "name": "subject",
              "value": "Reset your TraxKey AI password"
            },
            {
              "name": "html",
              "value": "={{ '<div style=\"font-family: Arial, sans-serif; font-size:14px; color:#1e293b;\"><p>Hi ' + $('Find User By Email').first().json.name + ',</p><p>Click below to reset your password. This link expires in 1 hour.</p><p><a href=\"https://app.traxkey.ai/reset-password?token=' + $json.token + '\">Reset password</a></p><p style=\"font-size:11px;color:#94a3b8;margin-top:24px;\">Didn\\'t request this? You can ignore this email.</p></div>' }}"
            }
          ]
        },
        "options": {}
      },
      "typeVersion": 4.2,
      "notes": "Needs a Resend httpHeaderAuth credential selected after import, same as the other Resend calls in this project.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "j1dEaIrQgTqwVHwA",
          "name": "Resend-email"
        }
      }
    },
    {
      "id": "rr-respond",
      "name": "Respond: Reset Requested",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        1024,
        -8
      ],
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"message\": \"If that email exists, a reset link is on its way.\" }"
      },
      "typeVersion": 1.1
    },
    {
      "id": "rr-respond-noop",
      "name": "Respond: Reset Requested (No User)",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        352,
        200
      ],
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"message\": \"If that email exists, a reset link is on its way.\" }"
      },
      "typeVersion": 1.1,
      "notes": "Same response whether or not the email exists, so this endpoint can't be used to check which emails have accounts."
    },
    {
      "id": "rp-webhook",
      "name": "Reset Password (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "position": [
        -320,
        400
      ],
      "webhookId": "traxkey-reset-password",
      "parameters": {
        "path": "traxkey-reset-password",
        "options": {
          "allowedOrigins": "*"
        },
        "httpMethod": "POST",
        "responseMode": "responseNode"
      },
      "typeVersion": 2.1
    },
    {
      "id": "rp-validate",
      "name": "Validate Reset Token",
      "type": "n8n-nodes-base.postgres",
      "position": [
        -96,
        400
      ],
      "parameters": {
        "query": "SELECT id FROM traxkey.users WHERE reset_token = '{{ $json.body.token.replace(/[^a-zA-Z0-9]/g, \"\") }}' AND reset_token_expires_at > now();",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "typeVersion": 2.5,
      "alwaysOutputData": true
    },
    {
      "id": "rp-if",
      "name": "Reset Token Valid?",
      "type": "n8n-nodes-base.if",
      "position": [
        128,
        400
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "rtv",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "leftValue": "={{ $json.id }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2
    },
    {
      "id": "rp-update",
      "name": "Update Password",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        320
      ],
      "parameters": {
        "query": "UPDATE traxkey.users\nSET password_hash = crypt('{{ $(\"Reset Password (Webhook)\").first().json.body.password.replace(/'/g, \"''\") }}', gen_salt('bf')),\n  reset_token = NULL, reset_token_expires_at = NULL\nWHERE id = '{{ $json.id }}';",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "typeVersion": 2.5
    },
    {
      "id": "rp-respond-ok",
      "name": "Respond: Password Reset",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        576,
        320
      ],
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={ \"success\": true }"
      },
      "typeVersion": 1.1
    },
    {
      "id": "rp-respond-invalid",
      "name": "Respond: Reset Token Invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        352,
        480
      ],
      "parameters": {
        "options": {
          "responseCode": 400
        },
        "respondWith": "json",
        "responseBody": "={ \"error\": \"This reset link is invalid or has expired.\" }"
      },
      "typeVersion": 1.1
    }
  ],
