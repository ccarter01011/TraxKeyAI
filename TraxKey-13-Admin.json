    {
      "id": "am-get",
      "name": "Get Metrics",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        340
      ],
      "notes": "MRR is DERIVED FROM PLAN TIER, not from actual collected payments. There is no billing integration yet, so this is an estimate of what accounts would bill at, not money received. Label it that way in the UI.",
      "parameters": {
        "query": "WITH plan_price AS (\n  SELECT * FROM (VALUES ('trial',0),('starter',99),('growth',249),('scale',549)) AS t(plan, price)\n),\ncompany_units AS (\n  SELECT p.company_id, count(u.id) AS unit_count\n  FROM traxkey.properties p LEFT JOIN traxkey.units u ON u.property_id = p.id\n  GROUP BY p.company_id\n)\nSELECT\n  (SELECT count(*) FROM traxkey.companies) AS total_companies,\n  (SELECT count(*) FROM traxkey.companies WHERE plan_status = 'trialing') AS trial_companies,\n  (SELECT count(*) FROM traxkey.companies WHERE plan_status = 'active') AS paying_companies,\n  (SELECT count(*) FROM traxkey.companies WHERE created_at > now() - interval '30 days') AS new_companies_30d,\n  (SELECT count(*) FROM traxkey.users) AS total_users,\n  (SELECT count(*) FROM traxkey.units) AS total_units,\n  (SELECT count(*) FROM traxkey.properties) AS total_properties,\n  (SELECT count(*) FROM traxkey.residents) AS total_residents,\n  (SELECT count(*) FROM traxkey.vendors) AS total_vendors,\n  (SELECT count(*) FROM traxkey.maintenance_requests) AS total_requests,\n  (SELECT count(*) FROM traxkey.maintenance_requests WHERE created_at > now() - interval '30 days') AS requests_30d,\n  (SELECT count(*) FROM traxkey.maintenance_requests WHERE status IN ('completed','closed')) AS completed_requests,\n  (SELECT count(*) FROM traxkey.unit_calendars) AS connected_calendars,\n  (SELECT COALESCE(SUM(pp.price),0) FROM traxkey.companies c JOIN plan_price pp ON pp.plan = c.plan WHERE c.plan_status = 'active') AS estimated_mrr,\n  (SELECT COALESCE(json_agg(row_to_json(x)), '[]') FROM (\n     SELECT c.name, c.plan, c.plan_status, c.created_at, COALESCE(cu.unit_count,0) AS unit_count\n     FROM traxkey.companies c LEFT JOIN company_units cu ON cu.company_id = c.id\n     ORDER BY c.created_at DESC LIMIT 50\n  ) x) AS companies,\n  (SELECT COALESCE(json_agg(row_to_json(l)), '[]') FROM (\n     SELECT id, name, email, company, portfolio_size, message, source, contacted_at, created_at\n     FROM traxkey.leads\n     ORDER BY created_at DESC LIMIT 100\n  ) l) AS leads;",
        "options": {},
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
