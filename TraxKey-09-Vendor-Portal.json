      "id": "vj-get",
      "name": "Get Vendor Jobs",
      "type": "n8n-nodes-base.postgres",
      "position": [
        352,
        544
      ],
      "parameters": {
        "query": "SELECT mr.id, mr.description, mr.category, mr.urgency, mr.status, mr.created_at,\n  u.unit_number, p.name AS property_name, p.address_line1, p.city, p.state\nFROM traxkey.maintenance_requests mr\nLEFT JOIN traxkey.units u ON u.id = mr.unit_id\nLEFT JOIN traxkey.properties p ON p.id = u.property_id\nWHERE mr.assigned_vendor_id = '{{ $json.vendor_id }}'\nAND mr.status IN ('scheduled', 'in_progress', 'completed')\nORDER BY mr.created_at DESC\nLIMIT 50;",
        "options": {},
        "operation": "executeQuery"
