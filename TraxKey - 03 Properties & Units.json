    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO traxkey.units (property_id, unit_number, bedrooms, bathrooms)\nSELECT\n  '{{ (String($(\"Create Unit (Webhook)\").first().json.body.propertyId || \"\")).replace(/[^a-zA-Z0-9._:-]/g, \"\") }}',\n  {{ $(\"Create Unit (Webhook)\").first().json.body.unitNumber ? \"'\" + $(\"Create Unit (Webhook)\").first().json.body.unitNumber.replace(/'/g, \"''\") + \"'\" : 'NULL' }},\n  {{ $(\"Create Unit (Webhook)\").first().json.body.bedrooms || 'NULL' }},\n  {{ $(\"Create Unit (Webhook)\").first().json.body.bathrooms || 'NULL' }}\nWHERE EXISTS (\n  SELECT 1 FROM traxkey.properties\n  WHERE id = '{{ (String($(\"Create Unit (Webhook)\").first().json.body.propertyId || \"\")).replace(/[^a-zA-Z0-9._:-]/g, \"\") }}'\n  AND company_id = '{{ $json.company_id }}'\n)\nRETURNING id;",
        "options": {}
      },
      "id": "33657783-bb7d-4ce3-aee1-4d483b0ac170",
      "name": "Insert Unit",
      "type": "n8n-nodes-base.postgres",
      "position": [
        800,
        832
      ],
      "typeVersion": 2.5,
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "rkxeF9x9C0rWEeWV",
          "name": "Postgres account"
        }
      },
      "notes": "The WHERE EXISTS clause is the tenant-isolation check: the property must belong to the caller's own company, or nothing gets inserted and this returns zero rows. Same pattern as TraxSail's inline session-scoped updates."
    },
